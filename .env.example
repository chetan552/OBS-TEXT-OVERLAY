# =============================================================================
# TextPresenter configuration
# =============================================================================
# Copy to .env and edit. Both `npm start` and `npm run channel` read it.
#
# Real environment variables always win over this file. That matters in
# production: the launchd plist and Render set their own values directly and
# do NOT read this file, so a stale .env can never override them. If you
# deploy with launchd, put your production values in the plist's
# EnvironmentVariables block, not here.
#
# The startup banner prints which variables it picked up from .env — check
# there first if a setting doesn't seem to apply.

# ---- Admin ------------------------------------------------------------------
# Password for the /admin panel. Without it the panel is disabled entirely
# and channels can only be managed with `npm run channel`.
# Use something long — this is the key to every church's channel.
ADMIN_PASSWORD=change-me-to-something-long

# ---- Public address ---------------------------------------------------------
# The hostname churches will use. Behind a Cloudflare Tunnel the request Host
# is internal, so the server needs this to print correct copy-paste links.
PUBLIC_URL=https://text.example.org

# ---- Network ----------------------------------------------------------------
PORT=3000

# 0.0.0.0 lets your own church reach the Mac mini directly over the LAN while
# everyone else arrives through the tunnel. Use 127.0.0.1 for tunnel-only.
HOST=0.0.0.0

# ---- WebSocket origins ------------------------------------------------------
# Exact origins allowed to open a WebSocket, comma separated. Set this once
# you're public — it's what stops another site from embedding your control
# page and driving it.
ALLOWED_ORIGINS=https://text.example.org

# Also accept LAN and localhost origins (192.168.x, 10.x, 172.16–31.x, .local).
# Leave true for the "public + LAN" setup; set to false for tunnel-only.
ALLOW_PRIVATE_ORIGINS=true

# ---- Storage ----------------------------------------------------------------
# Where channels.json and the session signing secret live. Back this up.
# DATA_DIR=/Users/Shared/textpresenter-data

# Session cookie signing key. Leave unset and one is generated into DATA_DIR
# on first run. Set it explicitly only if you want sessions to survive a
# move to a different machine.
# SESSION_SECRET=
